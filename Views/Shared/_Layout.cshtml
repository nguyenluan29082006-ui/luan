@using System.Security.Claims
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MêTruyệnPlus (ASP.NET Core 8 - C#)</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@0,300;0,400;0,700;1,300;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="app-container">
        <!-- Header / Navbar -->
        <header class="navbar">
            <div class="container navbar-container">
                <!-- Brand Logo -->
                <a href="/" class="nav-brand">
                    <div style="width: 38px; height: 38px; border-radius: 10px; background: linear-gradient(135deg, #6366f1, #ec4899); display: flex; align-items: center; justify-content: center; box-shadow: 0 0 16px rgba(99, 102, 241, 0.4); color: #fff; font-size: 1.2rem;">
                        📖
                    </div>
                    <span>MêTruyện<span style="color: #ec4899;">Plus</span></span>
                </a>

                <!-- Search Bar -->
                <form action="/Home/Genres" method="get" class="nav-search">
                    <span class="nav-search-icon">🔍</span>
                    <input type="text" name="search" placeholder="Tìm truyện, tác giả..." value="@Context.Request.Query["search"]" />
                </form>

                <!-- Navigation Links -->
                <nav class="nav-links">
                    <a href="/" class="nav-item">Trang chủ</a>
                    <a href="/Home/Genres" class="nav-item">Thể loại</a>
                    <a href="/Home/Favorites" class="nav-item">🔖 Tủ truyện</a>

                    @if (User.IsInRole("author") || User.IsInRole("admin"))
                    {
                        <a href="/Author" class="nav-item" style="color: #a78bfa;">✍️ Tác giả Studio</a>
                    }

                    @if (User.IsInRole("admin"))
                    {
                        <a href="/Admin" class="nav-item" style="color: #38bdf8;">🛡️ Quản trị (Admin)</a>
                    }

                    <a href="/swagger" target="_blank" class="nav-item" style="color: #34d399;" title="Xem Swagger API Docs">⚡ Swagger API</a>
                </nav>

                <!-- Auth / User Area -->
                <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <!-- Demo role quick switch button -->
                    <button type="button" class="btn btn-secondary btn-sm" onclick="document.getElementById('demoModal').classList.add('show')" style="border: 1px dashed var(--primary); font-size: 0.8rem;">
                        ✨ Đổi vai trò Demo
                    </button>

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <div style="display: flex; align-items: center; gap: 0.6rem; background: rgba(255, 255, 255, 0.06); padding: 0.35rem 0.75rem; border-radius: var(--radius-full); border: 1px solid var(--border-color);">
                            <span style="font-size: 0.875rem; font-weight: 600; color: #fff;">@User.Identity.Name</span>
                            <span class="badge @(User.IsInRole("admin") ? "badge-danger" : User.IsInRole("author") ? "badge-purple" : "badge-primary")" style="font-size: 0.65rem;">
                                @(User.IsInRole("admin") ? "Admin" : User.IsInRole("author") ? "Tác giả" : "Độc giả")
                            </span>
                            <a href="/Account/Logout" class="btn btn-sm btn-outline" style="padding: 0.2rem 0.5rem; font-size: 0.75rem; color: #f87171;" title="Đăng xuất">
                                Thoát
                            </a>
                        </div>
                    }
                    else
                    {
                        <a href="/Account/Login" class="btn btn-primary btn-sm">
                            👤 Đăng nhập
                        </a>
                    }
                </div>
            </div>
        </header>

        <!-- Main Content Body -->
        <main class="main-content">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="container" style="margin-top: 1.5rem;">
                    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="container" style="margin-top: 1.5rem;">
                    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
                </div>
            }
            @if (TempData["InfoMessage"] != null)
            {
                <div class="container" style="margin-top: 1.5rem;">
                    <div class="alert alert-info">@TempData["InfoMessage"]</div>
                </div>
            }

            @RenderBody()
        </main>

        <!-- Footer -->
        <footer style="background: rgba(11, 15, 25, 0.95); border-top: 1px solid var(--border-color); padding: 2.5rem 0 1.5rem 0; margin-top: auto;">
            <div class="container">
                <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1.5rem; margin-bottom: 1.5rem;">
                    <div style="display: flex; align-items: center; gap: 0.6rem;">
                        <span style="font-size: 1.2rem; font-weight: 800; color: #fff;">MêTruyện<span style="color: #ec4899;">Plus</span></span>
                        <span class="badge badge-primary">C# ASP.NET Core 8</span>
                        <span class="badge badge-purple">EF Core SQLite</span>
                    </div>
                    <div style="font-size: 0.85rem; color: var(--text-muted);">
                        Đồ án môn Công nghệ phần mềm nâng cao (CNPMNC) - 100% C# .NET 8
                    </div>
                </div>
                <div style="text-align: center; font-size: 0.8rem; color: var(--text-dim);">
                    © 2026 MêTruyệnPlus. Nền tảng quản lý và đọc truyện trực tuyến đa vai trò.
                </div>
            </div>
        </footer>
    </div>

    <!-- Quick Demo Modal Switcher -->
    <div id="demoModal" class="modal-backdrop" onclick="this.classList.remove('show')">
        <div class="modal-content" onclick="event.stopPropagation()" style="max-width: 440px; padding: 1.75rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
                <h3 style="font-size: 1.15rem; font-weight: 700; color: #fff;">✨ Đăng nhập nhanh vai trò Demo</h3>
                <button onclick="document.getElementById('demoModal').classList.remove('show')" style="color: var(--text-muted); font-size: 1.2rem;">✕</button>
            </div>
            <p style="font-size: 0.85rem; color: var(--text-muted); marginBottom: 1.25rem;">
                Chọn 1 trong 3 tài khoản để trải nghiệm toàn bộ các chức năng của hệ thống:
            </p>

            <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                <!-- Admin -->
                <form action="/Account/QuickLogin" method="post">
                    <input type="hidden" name="email" value="admin@doctruyen.vn" />
                    <button type="submit" style="width: 100%; text-align: left; padding: 0.85rem; border-radius: var(--radius-md); background: rgba(239, 68, 68, 0.08); border: 1px solid rgba(239, 68, 68, 0.25); cursor: pointer;">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <strong style="color: #f87171;">1. Quản Trị Viên (Admin)</strong>
                            <span class="badge badge-danger">ADMIN</span>
                        </div>
                        <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">
                            admin@doctruyen.vn - Duyệt truyện, xử lý báo cáo vi phạm, quản lý user.
                        </div>
                    </button>
                </form>

                <!-- Author -->
                <form action="/Account/QuickLogin" method="post">
                    <input type="hidden" name="email" value="tacgia@doctruyen.vn" />
                    <button type="submit" style="width: 100%; text-align: left; padding: 0.85rem; border-radius: var(--radius-md); background: rgba(139, 92, 246, 0.08); border: 1px solid rgba(139, 92, 246, 0.25); cursor: pointer;">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <strong style="color: #a78bfa;">2. Tác Giả (Author)</strong>
                            <span class="badge badge-purple">AUTHOR</span>
                        </div>
                        <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">
                            tacgia@doctruyen.vn - Đăng truyện mới chờ duyệt, viết chương mới.
                        </div>
                    </button>
                </form>

                <!-- Reader -->
                <form action="/Account/QuickLogin" method="post">
                    <input type="hidden" name="email" value="docgia@doctruyen.vn" />
                    <button type="submit" style="width: 100%; text-align: left; padding: 0.85rem; border-radius: var(--radius-md); background: rgba(99, 102, 241, 0.08); border: 1px solid rgba(99, 102, 241, 0.25); cursor: pointer;">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <strong style="color: #818cf8;">3. Độc Giả (Reader)</strong>
                            <span class="badge badge-primary">READER</span>
                        </div>
                        <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">
                            docgia@doctruyen.vn - Đọc truyện, lưu tủ truyện, bình luận, báo cáo.
                        </div>
                    </button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
