FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY ["Backend/WebDocTruyen.Backend.csproj", "Backend/"]
RUN dotnet restore "Backend/WebDocTruyen.Backend.csproj"
COPY . .
WORKDIR "/src/Backend"
RUN dotnet publish "WebDocTruyen.Backend.csproj" -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app
COPY --from=build /app/publish .
COPY Backend/database.db .
EXPOSE 5000
ENV ASPNETCORE_URLS=http://+:5000
ENTRYPOINT ["dotnet", "WebDocTruyen.Backend.dll"]
