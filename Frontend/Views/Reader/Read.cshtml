@model Chapter
@using System.Text.Json
@{
    Layout = null; // Independent reading layout for full immersion
    var story = Model.Story!;
    var prev = ViewBag.PrevChapter as Chapter;
    var next = ViewBag.NextChapter as Chapter;
    var allChapters = ViewBag.AllChapters as List<Chapter> ?? new List<Chapter>();

    bool isComic = story.Type == "comic";
    List<string> comicImages = new();
    if (isComic)
    {
        try
        {
            comicImages = JsonSerializer.Deserialize<List<string>>(Model.Content) ?? new();
        }
        catch { }
    }
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.Title - @story.Title</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@0,300;0,400;0,700;1,300;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        body.theme-dark { background-color: #0f172a; color: #e2e8f0; }
        body.theme-oled { background-color: #000000; color: #d1d5db; }
        body.theme-sepia { background-color: #fbf0d9; color: #2d241e; }
        body.theme-light { background-color: #ffffff; color: #1e293b; }

        .reader-nav {
            position: sticky;
            top: 0;
            z-index: 40;
            backdrop-filter: blur(10px);
            padding: 0.75rem 1.25rem;
            border-bottom: 1px solid rgba(255,255,255,0.08);
            background: rgba(15, 23, 42, 0.9);
        }
        body.theme-sepia .reader-nav { background: rgba(251, 240, 217, 0.95); border-color: rgba(0,0,0,0.1); color: #2d241e; }
        body.theme-light .reader-nav { background: rgba(255, 255, 255, 0.95); border-color: rgba(0,0,0,0.1); color: #1e293b; }
        body.theme-oled .reader-nav { background: rgba(0, 0, 0, 0.95); }

        .reading-content {
            font-family: var(--font-serif);
            font-size: 18px;
            line-height: 1.85;
            word-break: break-word;
            white-space: pre-line;
            text-align: justify;
        }
    </style>
</head>
<body class="theme-dark" id="readerBody">
    <!-- Sticky Reader Header -->
    <header class="reader-nav">
        <div class="container" style="display: flex; justify-content: space-between; align-items: center; gap: 1rem;">
            <!-- Back & Title -->
            <div style="display: flex; align-items: center; gap: 0.75rem;">
                <a href="/Story/Detail/@story.Id" class="btn btn-secondary btn-sm" style="font-size: 0.85rem;">
                    ← Chi tiết
                </a>
                <div>
                    <div style="font-size: 0.8rem; opacity: 0.7;">@story.Title</div>
                    <div style="font-size: 0.95rem; font-weight: 700;">@Model.Title</div>
                </div>
            </div>

            <!-- Toolbar Navigation -->
            <div style="display: flex; align-items: center; gap: 0.5rem;">
                @if (prev != null)
                {
                    <a href="/Reader/Read/@prev.Id" class="btn btn-secondary btn-sm">‹ Trước</a>
                }
                else
                {
                    <button class="btn btn-secondary btn-sm" disabled style="opacity: 0.5;">‹ Trước</button>
                }

                <button type="button" class="btn btn-secondary btn-sm" onclick="document.getElementById('chapterDrawer').classList.add('show')">
                    📑 Chương @Model.ChapterNumber
                </button>

                @if (next != null)
                {
                    <a href="/Reader/Read/@next.Id" class="btn btn-secondary btn-sm">Sau ›</a>
                }
                else
                {
                    <button class="btn btn-secondary btn-sm" disabled style="opacity: 0.5;">Sau ›</button>
                }

                @if (!isComic)
                {
                    <button type="button" class="btn btn-secondary btn-sm" onclick="toggleSettings()" title="Cài đặt đọc">
                        ⚙️ Cài đặt
                    </button>
                }
            </div>
        </div>
    </header>

    <!-- Reading Settings Drawer -->
    @if (!isComic)
    {
        <div id="settingsBar" style="display: none; padding: 1rem 0; border-bottom: 1px solid rgba(255,255,255,0.1); background: rgba(0,0,0,0.2);">
            <div class="container" style="display: flex; flex-wrap: wrap; gap: 2rem; align-items: center;">
                <div>
                    <span style="font-size: 0.8rem; font-weight: 600; display: block; margin-bottom: 0.4rem;">Màu nền:</span>
                    <div style="display: flex; gap: 0.4rem;">
                        <button type="button" class="btn btn-sm btn-secondary" onclick="setTheme('dark')">Tối</button>
                        <button type="button" class="btn btn-sm btn-secondary" onclick="setTheme('oled')">OLED</button>
                        <button type="button" class="btn btn-sm btn-secondary" onclick="setTheme('sepia')">Vàng Sepia</button>
                        <button type="button" class="btn btn-sm btn-secondary" onclick="setTheme('light')">Sáng</button>
                    </div>
                </div>

                <div>
                    <span style="font-size: 0.8rem; font-weight: 600; display: block; margin-bottom: 0.4rem;">Cỡ chữ:</span>
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <button type="button" class="btn btn-sm btn-secondary" onclick="changeFontSize(-2)">A-</button>
                        <span id="fontSizeVal" style="font-size: 0.9rem; font-weight: 600;">18px</span>
                        <button type="button" class="btn btn-sm btn-secondary" onclick="changeFontSize(2)">A+</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Main Content Reader -->
    <main class="container" style="max-width: @(isComic ? "840px" : "820px"); padding: 3rem 1.25rem 5rem 1.25rem;">
        <div style="text-align: center; margin-bottom: 3rem;">
            <div style="font-size: 0.9rem; opacity: 0.7; margin-bottom: 0.4rem; text-transform: uppercase;">@story.Title</div>
            <h1 style="font-size: 1.85rem; font-weight: 800;">@Model.Title</h1>
        </div>

        @if (isComic)
        {
            <div style="display: flex; flex-direction: column; gap: 0.5rem; align-items: center;">
                @foreach (var img in comicImages)
                {
                    <img src="@img" alt="Trang truyện" style="width: 100%; border-radius: 4px; box-shadow: 0 4px 10px rgba(0,0,0,0.3);" loading="lazy" />
                }
            </div>
        }
        else
        {
            <div class="reading-content" id="chapterText">
                @Model.Content
            </div>
        }

        <!-- Bottom Navigation -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 4rem; padding-top: 2rem; border-top: 1px solid rgba(255,255,255,0.1);">
            @if (prev != null)
            {
                <a href="/Reader/Read/@prev.Id" class="btn btn-secondary">‹ Chương trước</a>
            }
            else
            {
                <button class="btn btn-secondary" disabled style="opacity: 0.5;">‹ Chương trước</button>
            }

            <a href="/Story/Detail/@story.Id" class="btn btn-secondary">Mục lục</a>

            @if (next != null)
            {
                <a href="/Reader/Read/@next.Id" class="btn btn-primary">Chương sau ›</a>
            }
            else
            {
                <button class="btn btn-primary" disabled style="opacity: 0.5;">Chương sau ›</button>
            }
        </div>
    </main>

    <!-- Chapter Drawer Modal -->
    <div id="chapterDrawer" class="modal-backdrop" onclick="this.classList.remove('show')">
        <div class="modal-content" onclick="event.stopPropagation()" style="max-width: 480px; padding: 1.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                <h3 style="font-size: 1.15rem; font-weight: 700; color: #fff;">Danh sách chương</h3>
                <button onclick="document.getElementById('chapterDrawer').classList.remove('show')" style="color: var(--text-muted); font-size: 1.2rem;">✕</button>
            </div>
            <div style="display: flex; flex-direction: column; gap: 0.4rem; max-height: 420px; overflow-y: auto;">
                @foreach (var ch in allChapters)
                {
                    <a href="/Reader/Read/@ch.Id" style="padding: 0.75rem 1rem; border-radius: var(--radius-sm); text-decoration: none; color: @(ch.Id == Model.Id ? "var(--primary)" : "#fff"); background: @(ch.Id == Model.Id ? "rgba(99, 102, 241, 0.2)" : "rgba(255, 255, 255, 0.04)"); font-weight: @(ch.Id == Model.Id ? "700" : "400");">
                        @ch.Title
                    </a>
                }
            </div>
        </div>
    </div>

    <script>
        let currentSize = 18;
        function toggleSettings() {
            const bar = document.getElementById('settingsBar');
            bar.style.display = bar.style.display === 'none' ? 'block' : 'none';
        }

        function setTheme(theme) {
            document.getElementById('readerBody').className = 'theme-' + theme;
            localStorage.setItem('csharp_reader_theme', theme);
        }

        function changeFontSize(delta) {
            currentSize = Math.min(28, Math.max(14, currentSize + delta));
            const el = document.getElementById('chapterText');
            if (el) el.style.fontSize = currentSize + 'px';
            document.getElementById('fontSizeVal').innerText = currentSize + 'px';
            localStorage.setItem('csharp_reader_size', currentSize);
        }

        // Restore settings
        const savedTheme = localStorage.getItem('csharp_reader_theme');
        if (savedTheme) setTheme(savedTheme);
        const savedSize = localStorage.getItem('csharp_reader_size');
        if (savedSize) {
            currentSize = parseInt(savedSize);
            const el = document.getElementById('chapterText');
            if (el) el.style.fontSize = currentSize + 'px';
            const val = document.getElementById('fontSizeVal');
            if (val) val.innerText = currentSize + 'px';
        }
    </script>
</body>
</html>
