@model List<Story>
@{
    ViewData["Title"] = "Tác Giả Studio";
    var allGenres = ViewBag.AllGenres as List<Genre> ?? new List<Genre>();
}

<div class="container" style="padding: 2rem 1.25rem;">
    <!-- Header -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1.25rem; flex-wrap: wrap; gap: 1rem;">
        <div style="display: flex; align-items: center; gap: 0.75rem;">
            <div style="width: 42px; height: 42px; border-radius: 10px; background: linear-gradient(135deg, #a78bfa, #6366f1); display: flex; align-items: center; justify-content: center; font-size: 1.3rem;">
                ✍️
            </div>
            <div>
                <h1 style="font-size: 1.75rem; font-weight: 800; color: #fff;">Không Gian Tác Giả (Author Studio)</h1>
                <p style="font-size: 0.875rem; color: var(--text-muted);">Đăng tác phẩm mới, quản lý chương và theo dõi kết quả kiểm duyệt từ Ban Quản Trị</p>
            </div>
        </div>

        <button type="button" class="btn btn-primary" onclick="document.getElementById('createStoryModal').classList.add('show')">
            ➕ Đăng truyện mới
        </button>
    </div>

    <!-- Stories List -->
    @if (Model.Count == 0)
    {
        <div style="text-align: center; padding: 4rem 1rem; background: var(--bg-card); border-radius: var(--radius-lg); border: 1px solid var(--border-color);">
            <div style="font-size: 3rem; margin-bottom: 1rem;">📖</div>
            <h3 style="font-size: 1.25rem; font-weight: 700; color: #fff; margin-bottom: 0.5rem;">Bạn chưa đăng tải tác phẩm nào</h3>
            <p style="color: var(--text-muted); margin-bottom: 1.5rem;">Bắt đầu sáng tác và gửi tác phẩm đầu tay để Ban Quản Trị phê duyệt xuất bản!</p>
            <button type="button" class="btn btn-primary" onclick="document.getElementById('createStoryModal').classList.add('show')">
                ➕ Đăng truyện ngay
            </button>
        </div>
    }
    else
    {
        <div style="display: flex; flex-direction: column; gap: 1.25rem;">
            @foreach (var s in Model)
            {
                <div class="glass-card" style="padding: 1.5rem;">
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; align-items: center;">
                        <!-- Story Info -->
                        <div style="display: flex; gap: 1.25rem;">
                            <img src="@s.CoverUrl" alt="@s.Title" style="width: 80px; height: 115px; object-fit: cover; border-radius: var(--radius-md);" />
                            <div style="flex: 1;">
                                <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.35rem;">
                                    @if (s.ApprovalStatus == "approved")
                                    {
                                        <span class="badge badge-success">✓ Đã phê duyệt</span>
                                    }
                                    @if (s.ApprovalStatus == "pending")
                                    {
                                        <span class="badge badge-warning">⏳ Chờ Quản trị viên duyệt</span>
                                    }
                                    @if (s.ApprovalStatus == "rejected")
                                    {
                                        <span class="badge badge-danger">⚠️ Bị từ chối</span>
                                    }
                                    <span class="badge badge-primary">@(s.Type == "comic" ? "Truyện Tranh" : "Truyện Chữ")</span>
                                </div>

                                <h3 style="font-size: 1.15rem; font-weight: 700; color: #fff; margin-bottom: 0.25rem;">@s.Title</h3>
                                <div style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.5rem;">
                                    Tổng số chương: <strong style="color: #fff;">@(s.Chapters?.Count ?? 0)</strong> | Lượt xem: <strong style="color: #fff;">@s.Views.ToString("N0")</strong>
                                </div>

                                <div style="display: flex; flex-wrap: wrap; gap: 0.35rem;">
                                    @foreach (var sg in s.StoryGenres)
                                    {
                                        if (sg.Genre != null)
                                        {
                                            <span class="badge badge-primary" style="font-size: 0.7rem;">@sg.Genre.Name</span>
                                        }
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div style="display: flex; flex-wrap: wrap; gap: 0.6rem; justify-content: flex-end;">
                            @if (s.ApprovalStatus == "approved")
                            {
                                <a href="/Story/Detail/@s.Id" class="btn btn-secondary btn-sm">Xem ngoài web</a>
                            }

                            <button type="button" class="btn btn-primary btn-sm" onclick="openAddChapterModal(@s.Id, '@s.Title', @(s.Chapters?.Count ?? 0))">
                                ➕ Thêm chương
                            </button>

                            <form action="/Author/DeleteStory/@s.Id" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa bộ truyện này?')">
                                <button type="submit" class="btn btn-outline btn-sm" style="color: #f87171;">
                                    🗑️ Xóa
                                </button>
                            </form>
                        </div>
                    </div>

                    <!-- Rejection Alert -->
                    @if (s.ApprovalStatus == "rejected")
                    {
                        <div style="margin-top: 1.25rem; padding: 0.85rem 1.25rem; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); border-radius: var(--radius-md); color: #fca5a5; font-size: 0.875rem;">
                            <strong>⚠️ Phản hồi từ Ban Quản Trị:</strong>
                            <p style="margin-top: 0.25rem;">@(s.RejectionReason ?? "Nội dung chưa đạt tiêu chuẩn phê duyệt của nền tảng.")</p>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

<!-- Create Story Modal -->
<div id="createStoryModal" class="modal-backdrop" onclick="this.classList.remove('show')">
    <div class="modal-content" onclick="event.stopPropagation()" style="max-width: 600px; padding: 2rem;">
        <h2 style="font-size: 1.35rem; font-weight: 700; color: #fff; margin-bottom: 1.5rem;">Đăng Tải Tác Phẩm Mới</h2>
        <form action="/Author/CreateStory" method="post">
            <div class="form-group">
                <label class="form-label">Tên truyện (*)</label>
                <input type="text" name="title" class="form-control" placeholder="VD: Ta Là Kiếm Thần Vô Địch" required />
            </div>

            <div class="form-group">
                <label class="form-label">Hình thức truyện:</label>
                <div style="display: flex; gap: 1.5rem; margin-top: 0.35rem;">
                    <label style="display: flex; align-items: center; gap: 0.4rem; cursor: pointer;">
                        <input type="radio" name="type" value="novel" checked />
                        <span>Truyện Chữ (Novel)</span>
                    </label>
                    <label style="display: flex; align-items: center; gap: 0.4rem; cursor: pointer;">
                        <input type="radio" name="type" value="comic" />
                        <span>Truyện Tranh (Comic)</span>
                    </label>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">URL Ảnh bìa:</label>
                <input type="url" name="coverUrl" class="form-control" value="https://images.unsplash.com/photo-1543002588-bfa74002ed7e?w=500&auto=format&fit=crop&q=80" />
            </div>

            <div class="form-group">
                <label class="form-label">Thể loại:</label>
                <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
                    @foreach (var g in allGenres)
                    {
                        <label style="display: flex; align-items: center; gap: 0.3rem; background: rgba(255,255,255,0.05); padding: 0.3rem 0.6rem; border-radius: var(--radius-sm); font-size: 0.85rem; cursor: pointer;">
                            <input type="checkbox" name="genreIds" value="@g.Id" />
                            <span>@g.Name</span>
                        </label>
                    }
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Tóm tắt giới thiệu (*)</label>
                <textarea name="description" class="form-control" rows="4" placeholder="Giới thiệu nội dung truyện..." required></textarea>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 1.5rem;">
                <button type="button" class="btn btn-secondary" onclick="document.getElementById('createStoryModal').classList.remove('show')">Hủy</button>
                <button type="submit" class="btn btn-primary">Gửi Phê Duyệt</button>
            </div>
        </form>
    </div>
</div>

<!-- Add Chapter Modal -->
<div id="addChapterModal" class="modal-backdrop" onclick="this.classList.remove('show')">
    <div class="modal-content" onclick="event.stopPropagation()" style="max-width: 640px; padding: 2rem;">
        <h2 style="font-size: 1.35rem; font-weight: 700; color: #fff; margin-bottom: 1.5rem;" id="modalStoryTitle">Thêm Chương Mới</h2>
        <form action="/Author/CreateChapter" method="post">
            <input type="hidden" id="chapStoryId" name="storyId" value="0" />

            <div style="display: grid; grid-template-columns: 120px 1fr; gap: 1rem; margin-bottom: 1.25rem;">
                <div>
                    <label class="form-label">Số chương (*)</label>
                    <input type="number" id="chapNumber" name="chapterNumber" class="form-control" required />
                </div>
                <div>
                    <label class="form-label">Tên chương (*)</label>
                    <input type="text" id="chapTitle" name="title" class="form-control" placeholder="VD: Chương 1: Bước Ngoặt" required />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Nội dung chương (*)</label>
                <textarea name="content" class="form-control" rows="8" placeholder="Nhập nội dung truyện chữ hoặc mảng URL ảnh truyện tranh..." required></textarea>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 0.75rem; margin-top: 1.5rem;">
                <button type="button" class="btn btn-secondary" onclick="document.getElementById('addChapterModal').classList.remove('show')">Hủy</button>
                <button type="submit" class="btn btn-primary">Xuất Bản Chương</button>
            </div>
        </form>
    </div>
</div>

<script>
    function openAddChapterModal(storyId, storyTitle, currentChapterCount) {
        document.getElementById('chapStoryId').value = storyId;
        document.getElementById('modalStoryTitle').innerText = 'Thêm Chương Mới: ' + storyTitle;
        const nextNum = currentChapterCount + 1;
        document.getElementById('chapNumber').value = nextNum;
        document.getElementById('chapTitle').value = 'Chương ' + nextNum + ': ';
        document.getElementById('addChapterModal').classList.add('show');
    }
</script>
